# 이 파일을 .env로 복사한 뒤 실제 발급받은 키 값을 채워 넣으세요.
# server.py가 시작할 때 .env를 자동으로 읽어 환경변수로 설정합니다(값이 없으면 해당 기능만 비활성화).

# 공공데이터포털 — 국토교통부 아파트 매매/전월세 실거래가
DATA_GO_KR_KEY=

# 카카오 디벨로퍼스 — REST API 키(지오코딩, 서버 전용, 절대 브라우저에 노출 금지)
KAKAO_REST_KEY=

# 서울 열린데이터광장 — 일반 오픈API 키(공원·상권·실시간 도시데이터)
SEOUL_OPEN_DATA_KEY=

# KOSIS(국가통계포털) — 인구·세대·고령화 + 한국부동산원 공동주택 실거래가격지수
KOSIS_KEY=

# 나이스 교육정보 개방포털(NEIS) — 학교 기본정보(학군)
NEIS_KEY=
